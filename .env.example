# Server porti
PORT=3000
# O'qituvchi paroli ("O'qituvchi sifatida kirish" uchun). Albatta o'zgartiring.
TEACHER_PASSWORD=change-me
# Sessiya kaliti: uzun tasodifiy satr (o'rnatilmasa, har ishga tushganda yangisi yaratiladi va o'qituvchi qayta kiradi)
SESSION_SECRET=
# Sinflar saqlanadigan papka (standart: ./data)
DATA_DIR=./data
NODE_ENV=production
